{
  "name": "menote",
  "version": "1.2.0",
  "description": "轻量级个人知识库系统",
  "main": "server.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node server.js",
    "dev": "cross-env NODE_ENV=development node server.js",
    "dev:web": "vite --config web/vite.config.mjs",
    "build:vendor": "node web/vendor-vditor.mjs",
