  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "cross-env": "^10.1.0",
    "element-plus": "^2.14.5",
    "sortablejs": "^1.15.7",
    "vditor": "^4.0.0",
    "vis-network": "^9.1.13",
    "vite": "^8.3.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  }
